{% assign desktop_menu = section.settings.desktop_menu | default: linklists['main-menu'] %}

<site-header data-component="header" data-enable-sticky="{{ section.settings.enable_sticky_header }}">
  <div class="header {% if section.settings.enable_full_width %}header--full-width{% endif %}">
    <div class="header__bar">
      <div class="header__inner">
        {% render 'header-logo', section: section, class: 'header__logo' %}

        <nav class="header__navigation" aria-label="{{ 'accessibility.header_navigation_label' | t }}">
          <ul class="header__nav-list">
            {% for link in desktop_menu.links %}
              {% liquid
                assign link_handle = link.title | handle
                assign has_menu_content = false
                for card in section.blocks
                  if card.type == 'menu_image' or card.type == 'menu_copy'
                    assign card_menu_handle = card.settings.menu_id | handle
                    if card_menu_handle == link_handle and card.settings.parent_menu == blank
                      assign has_menu_content = true
                      break
                    endif
                  endif
                endfor
              %}
              <li
                class="header__nav-list-item"
                {% if link.links.size > 0 or has_menu_content %}data-mega-menu-hover="mega-menu-{{ link_handle }}-{{ forloop.index }}"{% endif %}
              >
                <a href="{{ link.url }}" class="header__nav-link">{{ link.title }}</a>
                {% if link.links.size > 0 or has_menu_content %}
                  <button
                    type="button"
                    class="header__mega-menu-trigger"
                    data-mega-menu-trigger="mega-menu-{{ link_handle }}-{{ forloop.index }}"
                    aria-controls="mega-menu-{{ link_handle }}-{{ forloop.index }}"
                    aria-expanded="false"
                    aria-label="{{ 'accessibility.show_submenu' | t: title: link.title }}"
                  >
                    {% render 'icon-chevron-down' %}
                  </button>
                  {% render 'mega-menu', mega_menu: link, section: section, index: forloop.index %}
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </nav>

        <ul class="header__action-list">
          <li>
            {%- capture icon_search -%}{% render 'icon-search' %}{%- endcapture -%}
            {%- capture label_search -%}{{ 'placeholders.search' | t }}{%- endcapture -%}
            {% render 'icon-button', as: 'button', icon: icon_search, label: label_search, attr: 'data-search-drawer-trigger aria-expanded="false"' %}
          </li>
          <li class="header__desktop-action">
            {%- capture icon_account -%}{% render 'icon-account' %}{%- endcapture -%}
            {%- capture label_account -%}{{ 'accessibility.account' | t }}{%- endcapture -%}
            {%- capture href_account -%}{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.storefront_login_url }}{%- endif -%}{%- endcapture -%}
            {% render 'icon-button', as: 'link', icon: icon_account, label: label_account, href: href_account %}
          </li>
          {% if section.settings.wishlist_url != blank %}
            <li class="header__desktop-action">
              {%- capture icon_wishlist -%}<svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 27.2 5.4 16.7C-1.1 10.2 8.2 1.6 16 9.4c7.8-7.8 17.1.8 10.6 7.3L16 27.2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>{%- endcapture -%}
              {% render 'icon-button', as: 'link', icon: icon_wishlist, label: 'Wishlist', href: section.settings.wishlist_url %}
            </li>
          {% endif %}
          <li>
            {%- capture icon_bag -%}{% render 'icon-shopping-bag' %}{%- endcapture -%}
            {%- capture label_cart -%}{{ 'accessibility.cart' | t }}{%- endcapture -%}
            {% render 'icon-button', as: 'button', icon: icon_bag, label: label_cart, attr: 'data-cart-toggle-button' %}
          </li>
          <li class="header__mobile-action">
            {%- capture icon_menu -%}{% render 'icon-menu-hamburger' %}{%- endcapture -%}
            {%- capture label_menu -%}{{ 'accessibility.menu' | t }}{%- endcapture -%}
            {% render 'icon-button', as: 'button', icon: icon_menu, label: label_menu, attr: 'data-mobile-mega-menu-trigger aria-expanded="false"' %}
          </li>
        </ul>
      </div>
    </div>

    {% render 'search-drawer', section: section %}
    {% if product %}
      {% render 'mobile-floating-header' %}
    {% endif %}
    {% render 'mobile-mega-menu', section: section %}
  </div>
</site-header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "header", "content": "Header options" },
    { "type": "image_picker", "id": "logo", "label": "Header logo", "info": "Uses the global logo or Lésoles logo when blank." },
    { "type": "checkbox", "id": "enable_sticky_header", "label": "Enable sticky header", "default": true },
    { "type": "checkbox", "id": "enable_full_width", "label": "Full width", "default": true },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist page URL", "info": "The heart icon appears when a URL is set." },
    { "type": "header", "content": "Menus" },
    { "type": "link_list", "id": "desktop_menu", "label": "Menu (desktop)" },
    { "type": "link_list", "id": "mobile_menu", "label": "Menu (mobile)" },
    { "type": "link_list", "id": "utility_menu", "label": "Utility menu (mobile)" },
    { "type": "header", "content": "Search" },
    { "type": "checkbox", "id": "show_search_cta", "label": "Show search button", "default": false },
    { "type": "text", "id": "search_heading", "label": "Search heading", "default": "Find your next pair." },
    { "type": "text", "id": "search_description", "label": "Search description", "default": "Search styles, sizes and more." },
    { "type": "link_list", "id": "search_links", "label": "Search quick links" },
    { "type": "text", "id": "search_links_heading", "label": "Quick links heading", "default": "Popular categories" }
  ],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu setup",
      "settings": [
        { "type": "text", "id": "menu_id", "label": "Top-level menu title", "info": "Match the title in the desktop menu, for example Shop." },
        {
          "type": "select",
          "id": "menu_type",
          "label": "Submenu style",
          "options": [
            { "value": "list", "label": "Text links" },
            { "value": "enhanced-list", "label": "Image links" }
          ],
          "default": "list"
        },
        {
          "type": "select",
          "id": "columns",
          "label": "Submenu columns",
          "options": [
            { "value": "1", "label": "1" },
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" },
            { "value": "4", "label": "4" }
          ],
          "default": "2"
        },
        { "type": "text", "id": "link_text", "label": "Footer link text" },
        { "type": "url", "id": "link_url", "label": "Footer link URL" }
      ]
    },
    {
      "type": "menu_copy",
      "name": "Menu copy",
      "settings": [
        { "type": "text", "id": "menu_id", "label": "Top-level menu title", "info": "Match the exact title in the menu, for example Home. Use one copy block per menu level." },
        { "type": "text", "id": "parent_menu", "label": "Second-level menu title", "info": "Leave blank for the top-level panel. Set this to a child menu title for its panel." },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "link_text", "label": "Link text" },
        { "type": "url", "id": "link_url", "label": "Link URL", "info": "Uses the matching menu link when blank." }
      ]
    },
    {
      "type": "menu_image",
      "name": "Menu content card",
      "settings": [
        { "type": "text", "id": "menu_id", "label": "Top-level menu title", "info": "Match a top-level menu title, for example Shop." },
        { "type": "text", "id": "parent_menu", "label": "Second-level menu title", "info": "Leave blank to show in the top-level menu. Enter a category title to show only when that category is open." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback_art",
          "label": "Placeholder art when no image is selected",
          "options": [
            { "value": "product", "label": "Footwear" },
            { "value": "lifestyle", "label": "Lifestyle" }
          ],
          "default": "product"
        },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "excerpt", "label": "Description" },
        { "type": "text", "id": "link_text", "label": "Link text" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    }
  ]
}
{% endschema %}
