<div class="mobile-header" data-component="mobile-header">
  <a href="{{ routes.root_url }}" class="mobile-header__logo">
    <span class="sr-only">
      {{- 'general.navigation.home' | t: store_name: shop.name, domain: shop.domain -}}
    </span>
    {% if settings.logo != blank %}
      {{ settings.logo | image_url: width: 200 | image_tag }}
    {% endif %}
  </a>
</div>
