<search-input data-component="search-input">
  <div class="search-input">
    <div class="search-input__icon">
      {% render 'icon-search' %}
    </div>
    <label for="{{ id }}" class="sr-only">{{ 'content.search_input_label' | t }}</label>
    <input
      id="{{ id }}"
      class="search-input__input"
      type="search"
      name="q"
      value="{{ value | escape }}"
      placeholder="{{ 'placeholders.search' | t }}"
      autocomplete="off"
      enterkeyhint="search"
    >
    <button
      class="search-input__close"
      type="button"
      data-search-input-clear
      aria-label="{{ 'actions.clear' | t }}"
      {% if value == blank %}hidden{% endif %}
    >
      {% render 'icon-clear' %}
    </button>
  </div>
</search-input>
