{% comment %}

 SheerID - Education Discount for Students and Teachers
 Installation based on SheerID Docs
 https://developer.sheerid.com/tutorials/verifications/embedded#install-script

{% endcomment %}

<div
  data-component="sheer-id"
  class="sheer-id"
  style="{% render 'color-scheme-vars', color_scheme: section.settings.color_scheme %}"
>
  <div class="sheer-id__content">
    {% render 'content-blocks', section_settings: section.settings, blocks: section.blocks, sheer_id: true %}

    <script type="module">
      import sheerId from "https://cdn.jsdelivr.net/npm/@sheerid/jslib@2/sheerid-install.js"

      const buttons = [
        {% for block in section.blocks %}
          {% if block.type == 'button' %}
            {
              id: "{{ block.id }}",
              url: {{ block.settings.url | json }}
            },
          {% endif %}
        {% endfor %}
      ]

      buttons.forEach(button => {
        const element = document.getElementById(button.id)
        if (!element) return

        element.addEventListener("click", (e) => {
          e.preventDefault()
          sheerId.loadInModal(button.url, {
            mobileRedirect: false,
          })
        })
      })
    </script>
  </div>
</div>

{% schema %}
{
  "name": "SheerID",
  "settings": [
        {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Text Alignment - Mobile",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
