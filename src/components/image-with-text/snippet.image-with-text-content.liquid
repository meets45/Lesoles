{% liquid
  assign has_buttons = false

  for block in blocks
    if block.type == 'button' and block.settings.label != blank and block.settings.url != blank
      assign has_buttons = true
      break
    endif
  endfor
%}

<div class="image-with-text__blocks">
  {% for block in blocks %}
    {% liquid
      assign visibility = block.settings.visible_on | default: 'all'
      assign desktop_text = block.settings.text
      assign mobile_text = block.settings.text_mobile | default: desktop_text
    %}

    {% unless block.type == 'button' %}
      <div
        class="image-with-text__block image-with-text__block--{{ block.type }} image-with-text__block--{{ visibility }}"
        {{ block.shopify_attributes }}
      >
        {% case block.type %}
          {% when 'eyebrow' %}
            {% if desktop_text != blank %}
              <p class="image-with-text__eyebrow subheading-xsmall">
                <span class="image-with-text__desktop-text">{{ desktop_text | escape }}</span>
                <span class="image-with-text__mobile-text">{{ mobile_text | escape }}</span>
              </p>
            {% endif %}

          {% when 'heading' %}
            {% if desktop_text != blank %}
              <h2
                class="image-with-text__heading {{ block.settings.heading_size | default: 'display-small' }}"
                {% if block.settings.heading_color != blank %}style="color: {{ block.settings.heading_color }};"{% endif %}
              >
                <span class="image-with-text__desktop-text">{{ desktop_text | escape }}</span>
                <span class="image-with-text__mobile-text">{{ mobile_text | escape }}</span>
              </h2>
            {% endif %}

          {% when 'body' %}
            {% if desktop_text != blank %}
              <div class="image-with-text__body rte">
                <div class="image-with-text__desktop-text">{{ desktop_text }}</div>
                <div class="image-with-text__mobile-text">{{ mobile_text }}</div>
              </div>
            {% endif %}

          {% when 'text_link' %}
            {% if block.settings.label != blank and block.settings.url != blank %}
              {% capture link_icon %}
                {% if block.settings.icon_left != blank %}
                  {{
                    block.settings.icon_left
                    | image_url: width: 48
                    | image_tag: loading: 'lazy', widths: '24,48', class: 'image-with-text__link-image', alt: ''
                  }}
                {% endif %}
              {% endcapture %}
              {% capture link_label %}
                <span class="image-with-text__desktop-text">{{ block.settings.label | escape }}</span>
                <span class="image-with-text__mobile-text">{{ block.settings.label_mobile | default: block.settings.label | escape }}</span>
              {% endcapture %}
              {% render 'text-link', href: block.settings.url, label: link_label, arrow: block.settings.show_icon, icon: link_icon %}
            {% endif %}
        {% endcase %}
      </div>
    {% endunless %}
  {% endfor %}

  {% if has_buttons %}
    <div class="image-with-text__buttons">
      {% for block in blocks %}
        {% if block.type == 'button' and block.settings.label != blank and block.settings.url != blank %}
          {% capture button_label %}
            <span class="image-with-text__desktop-text">{{ block.settings.label | escape }}</span>
            <span class="image-with-text__mobile-text">{{ block.settings.label_mobile | default: block.settings.label | escape }}</span>
          {% endcapture %}
          {% capture button_attributes %}
            {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
          {% endcapture %}
          <div
            class="image-with-text__button image-with-text__block--{{ block.settings.visible_on | default: 'all' }}"
            {{ block.shopify_attributes }}
          >
            {% render 'button', as: 'a', href: block.settings.url, label: button_label, variant: block.settings.variant, attr: button_attributes %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div>
