{% liquid
  assign link_presentation = link_presentation | default: 'link'
  assign button_variant = button_variant | default: 'primary'
  assign full_card_link_label = link_text | default: heading | default: 'View content card'
%}

<div
  data-component="content-card"
  class="
    content-card
    content-card--{{ style }}
    {% if image_ratio %}
      content-card--ratio-{{ image_ratio | replace: ':', '-' }}
    {% endif %}
  "
>
  {% if link_url != blank and link_entire_card %}
    <a
      href="{{ link_url }}"
      class="content-card__link-wrapper content-card__link-wrapper--full-card"
      aria-label="{{ full_card_link_label | escape }}"
    ></a>
  {% elsif link_url != blank and style == 'overlay' and link_presentation != 'button' %}
    <a href="{{ link_url }}" class="content-card__link-wrapper">
  {% endif %}

  {% if style == 'enhanced' %}
    <div class="content-card__content">
      {% if heading != blank %}
        <h3 class="content-card__heading display-small">
          {{ heading }}
        </h3>
      {% endif %}

      {% if link_url != blank %}
        {% if link_entire_card and link_presentation == 'button' %}
          {% render 'button', as: 'span', label: link_text, variant: button_variant, tiny: true, attr: 'aria-hidden="true"' %}
        {% elsif link_entire_card %}
          <span class="content-card__link" aria-hidden="true">
            <span class="text-link">{{ link_text }}</span>
            <span class="content-card__link-icon">
              {% render 'icon-arrow-right' %}
            </span>
          </span>
        {% elsif link_presentation == 'button' %}
          {% render 'button', as: 'a', label: link_text, href: link_url, variant: button_variant, tiny: true %}
        {% else %}
          <a href="{{ link_url }}" class="content-card__link">
            <span class="text-link">{{ link_text }}</span>
            <span class="content-card__link-icon">
              {% render 'icon-arrow-right' %}
            </span>
          </a>
        {% endif %}
      {% endif %}
    </div>
  {% endif %}

  {% if image %}
    <div class="content-card__image">
      {{ image | image_url: width: 800 | image_tag: loading: 'lazy' }}
    </div>
  {% endif %}

  {% if style == 'overlay' %}
    <div class="content-card__scrim"></div>
  {% endif %}

  {% if style != 'enhanced' %}
    <div class="content-card__content">
      {% if heading != blank %}
        <h3 class="content-card__heading {% if style == 'standard' %}heading-medium{% else %}display-small{% endif %}">
          {{ heading }}
        </h3>
      {% endif %}

      {% if description != blank and style == 'standard' %}
        <div class="content-card__description body-medium">
          {{ description }}
        </div>
      {% endif %}

      {% if link_url != blank and style == 'standard' %}
        {% if link_entire_card and link_presentation == 'button' %}
          {% render 'button', as: 'span', label: link_text, variant: button_variant, tiny: true, attr: 'aria-hidden="true"' %}
        {% elsif link_entire_card %}
          <span class="content-card__link" aria-hidden="true">
            <span class="text-link">{{ link_text }}</span>
            <span class="content-card__link-icon">
              {% render 'icon-arrow-right' %}
            </span>
          </span>
        {% elsif link_presentation == 'button' %}
          {% render 'button', as: 'a', label: link_text, href: link_url, variant: button_variant, tiny: true %}
        {% else %}
          <a href="{{ link_url }}" class="content-card__link">
            <span class="text-link">{{ link_text }}</span>
            <span class="content-card__link-icon">
              {% render 'icon-arrow-right' %}
            </span>
          </a>
        {% endif %}
      {% endif %}

      {% if style == 'overlay' %}
        {% if link_entire_card and link_presentation == 'button' and link_url != blank %}
          {% render 'button', as: 'span', label: link_text, variant: button_variant, tiny: true, attr: 'aria-hidden="true"' %}
        {% elsif link_presentation == 'button' and link_url != blank %}
          {% render 'button', as: 'a', label: link_text, href: link_url, variant: button_variant, tiny: true %}
        {% else %}
          <div class="content-card__icon">
            {% render 'icon-chevron-right' %}
          </div>
        {% endif %}
      {% endif %}
    </div>
  {% endif %}

  {% if link_url != blank and style == 'overlay' and link_presentation != 'button' and link_entire_card != true %}
    </a>
  {% endif %}
</div>
