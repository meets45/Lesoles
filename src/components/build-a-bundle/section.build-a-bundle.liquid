<build-a-bundle data-component="build-a-bundle">
  <div
    class="build-a-bundle"
    style="{% render 'color-scheme-vars', color_scheme: section.settings.color_scheme %}"
  >
    <div class="build-a-bundle__inner">
      <div class="build-a-bundle__content">
        <div class="build-a-bundle__header">
          {% if section.settings.eyebrow != blank %}
            <p class="build-a-bundle__eyebrow subheading-xsmall">
              {{ section.settings.eyebrow }}
            </p>
          {% endif %}

          {% if section.settings.title != blank %}
            <h2 class="build-a-bundle__title display-medium">
              {{ section.settings.title }}
            </h2>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="build-a-bundle__description body-medium">
              {{ section.settings.description }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="build-a-bundle__categories">
        {% for block in section.blocks %}
          {% if block.type == 'category' %}
            <div class="build-a-bundle__category" data-category="{{ block.settings.category_id }}" {{ block.shopify_attributes }}>
              <div class="build-a-bundle__category-header">
                <h3 class="build-a-bundle__category-title heading-small">
                  {{ block.settings.category_title }}
                </h3>

                <button
                  type="button"
                  class="build-a-bundle__reset button button--secondary"
                  data-reset-selection="{{ block.settings.category_id }}"
                  style="display: none;"
                >
                  {{ block.settings.reset_text | default: 'RESET SELECTION' }}
                </button>
              </div>

              <div class="build-a-bundle__slider" data-slider="{{ block.settings.category_id }}">
                <div class="swiper" data-swiper>
                  <div class="swiper-wrapper">
                    {% for product in block.settings.collection.products
                      limit: block.settings.products_to_show
                    %}
                      <div class="swiper-slide">
                        {% render 'bundle-product-card',
                          product: product,
                          category_id: block.settings.category_id
                        %}
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
              <div class="build-a-bundle__scrollbar" data-scrollbar="{{ block.settings.category_id }}">
                <span></span>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</build-a-bundle>

{% schema %}
  {
    "name": "Build a Bundle",
    "settings": [
      {
        "type": "text",
        "id": "eyebrow",
        "label": "Eyebrow"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Build Your Bundle"
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "Description"
      },
      {
        "type": "checkbox",
        "id": "show_reset_button",
        "label": "Show Reset Button",
        "default": true
      },
      {
        "type": "text",
        "id": "reset_text",
        "label": "Reset Button Text",
        "default": "RESET SELECTION"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "color_scheme_1"
      }
    ],
    "blocks": [
      {
        "type": "category",
        "name": "Product Category",
        "settings": [
          {
            "type": "text",
            "id": "category_id",
            "label": "Category ID",
            "info": "Unique identifier for this category (e.g., backpack, lunch_bag, accessory)",
            "default": "category"
          },
          {
            "type": "text",
            "id": "category_title",
            "label": "Category Title",
            "default": "Select a Product"
          },
          {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
          },
          {
            "type": "range",
            "id": "products_to_show",
            "min": 4,
            "max": 48,
            "step": 1,
            "default": 16,
            "label": "Products to show"
          },
          {
            "type": "text",
            "id": "reset_text",
            "label": "Reset Button Text",
            "default": "RESET SELECTION"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Build a Bundle",
        "settings": {
          "title": "Build Your Bundle",
          "show_reset_button": true
        },
        "blocks": [
          {
            "type": "category",
            "settings": {
              "category_id": "backpack",
              "category_title": "SELECT A BACKPACK"
            }
          },
          {
            "type": "category",
            "settings": {
              "category_id": "lunch_bag",
              "category_title": "SELECT A LUNCH BAG"
            }
          },
          {
            "type": "category",
            "settings": {
              "category_id": "accessory",
              "category_title": "SELECT AN ACCESSORY"
            }
          }
        ]
      }
    ]
  }
{% endschema %}
