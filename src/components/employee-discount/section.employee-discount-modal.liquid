<employee-discount data-component="employee-discount">
  <site-modal id="employee-discount-modal">
    <div
      class="modal micromodal-slide employee-discount-modal"
      id="employee-discount-modal"
      aria-hidden="true"
      data-modal
    >
      <div class="modal__overlay" tabindex="-1">
        <div
          class="modal__container"
          role="dialog"
          aria-modal="true"
          aria-labelledby="employee-discount-modal-title"
        >
          <header class="modal__header">
            <h2 class="modal__title" id="employee-discount-modal-title">
              {{ settings.employee_modal_title }}
            </h2>
          </header>

          <main class="modal__content" id="employee-discount-modal-content">
            {% if settings.employee_modal_content != blank %}
              {{ settings.employee_modal_content }}
            {% endif %}
          </main>

          <footer class="modal__footer">
            <button
              class="button button--secondary"
              data-terms-reject
            >
              {{ 'employee_discount.terms.reject' | t }}
            </button>

            <button
              class="button button--primary"
              data-terms-accept
            >
              {{ 'employee_discount.terms.accept' | t }}
            </button>
          </footer>
        </div>
      </div>
    </div>
  </site-modal>
</employee-discount>
