{%- liquid
  assign display_font = settings.font_display
  assign heading_font = settings.font_heading
  assign subheading_font = settings.font_subheading
  assign body_font = settings.font_body
  assign display_font_key = display_font.family | append: '-' | append: display_font.weight | append: '-' | append: display_font.style
  assign heading_font_key = heading_font.family | append: '-' | append: heading_font.weight | append: '-' | append: heading_font.style
  assign subheading_font_key = subheading_font.family | append: '-' | append: subheading_font.weight | append: '-' | append: subheading_font.style
  assign body_font_key = body_font.family | append: '-' | append: body_font.weight | append: '-' | append: body_font.style
-%}

{%- capture theme_font_faces -%}
  {%- if display_font != blank -%}
    {{ display_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if heading_font != blank and heading_font_key != display_font_key -%}
    {{ heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if subheading_font != blank and subheading_font_key != display_font_key and subheading_font_key != heading_font_key -%}
    {{ subheading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if body_font != blank and body_font_key != display_font_key and body_font_key != heading_font_key and body_font_key != subheading_font_key -%}
    {{ body_font | font_face: font_display: 'swap' }}
  {%- endif -%}
{%- endcapture -%}

{%- if theme_font_faces != blank -%}
  <style>{{ theme_font_faces }}</style>
{%- endif -%}

{{
  'fredoka-latin-wght-normal.woff2'
  | asset_url
  | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous'
}}
{{
  'fredoka-latin-ext-wght-normal.woff2'
  | asset_url
  | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous'
}}

<style>
  @font-face {
    font-family: 'Fredoka';
    src: url("{{ 'fredoka-latin-wght-normal.woff2' | asset_url }}") format('woff2');
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190, U+2191, U+2192, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Fredoka';
    src: url("{{ 'fredoka-latin-ext-wght-normal.woff2' | asset_url }}") format('woff2');
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
</style>
