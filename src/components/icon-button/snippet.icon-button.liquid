{% assign as = as | default: 'a' %}
{% assign type = type | default: 'button' %}
{% assign class = class | default: '' %}
{% assign attr = attr | default: '' %}
{% assign show_badge = false %}
{% assign cart_items_count = cart.item_count %}

{% if attr contains "data-cart-toggle-button" %}
  {% assign show_badge = true %}
{% endif %}

{% assign additional_classes = '' %}
{% if show_badge and cart_items_count == 0 %}
  {% assign additional_classes = 'hidden' %}
{% endif %}

{% case as %}
  {% when 'a', 'link' %}
    <a
      data-component="icon-button"
      class="icon-button {{ class }}"
      href="{{ href }}"
      {{ attr }}
    >
      <div class="icon-button__icon">
        {{ icon }}
        {% if show_badge and cart_items_count > 0 %}
          <span class="icon-button__badge {{ additional_classes }}">{{ cart_items_count }}</span>
        {% endif %}
      </div>
      <span class="sr-only">{{ label }}</span>
    </a>

  {% when 'button' %}
    <button
      data-component="icon-button"
      class="icon-button {{ class }}"
      type="{{ type }}"
      {{ attr }}
    >
      <div class="icon-button__icon">
        {{ icon }}
        {% if show_badge and cart_items_count > 0 %}
          <span class="icon-button__badge {{ additional_classes }}">{{ cart_items_count }}</span>
        {% endif %}
      </div>
      <span class="sr-only">{{ label }}</span>
    </button>
{% endcase %}
