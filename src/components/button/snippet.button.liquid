{%- capture class -%}
  button
  {%- case variant -%}
  {%- when 'secondary' %}
      button--secondary
  {%- when 'tertiary' %}
      button--tertiary
  {%- endcase -%}
  {% if tiny %}
      button--tiny
  {%- endif -%}
{%- endcapture -%}

{% assign as = as | default: 'button' %}
{%- case as -%}
{%- when 'a' -%}
  <a
    {% if id -%}
      id="{{ id }}"
    {% endif %}
    class="{{- class -}}"
    href="{{ href }}"
    {{ attr }}
  >
    {% if icon %}
      <div class="button__icon">
        {{ icon }}
      </div>
    {% endif %}

    {{ label }}
    {% if settings.button_show_arrow %}
      <span class="button__icon button__icon--arrow" aria-hidden="true">
        {% render 'icon-arrow-upper-right' %}
      </span>
    {% endif %}
  </a>

{%- when 'button' -%}
  <button
    class="{{- class -}}"
    type="{{ type | default: 'button' }}"
    {% if disabled -%}
      disabled
    {%- endif %}
    {{ attr }}
  >
    {% if icon %}
      <div class="button__icon">
        {{ icon }}
      </div>
    {% endif %}
    {{ label }}
    {% if settings.button_show_arrow %}
      <span class="button__icon button__icon--arrow" aria-hidden="true">
        {% render 'icon-arrow-upper-right' %}
      </span>
    {% endif %}
  </button>

{%- when 'span' -%}
  <span class="{{- class -}}" {{ attr }}>
    {{ label }}
    {% if settings.button_show_arrow %}
      <span class="button__icon button__icon--arrow" aria-hidden="true">
        {% render 'icon-arrow-upper-right' %}
      </span>
    {% endif %}
  </span>
{%- endcase -%}
