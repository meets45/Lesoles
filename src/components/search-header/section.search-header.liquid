{% assign input_id = 'search-input' | append: section.id %}

<div
  data-component="search-header"
  data-search-header
>
  <div class="search-header">
    <div class="search-header__search">
      {% if search.terms != blank %}
        <h1 class="sr-only">
          {{ 'content.search_results' | t }}: {{ search.terms | escape }}
        </h1>
      {% else %}
        <h1 class="sr-only">
          {{ 'content.search' | t }}
        </h1>
      {% endif %}
      <form action="{{ routes.search_url }}" method="get" role="search">
        {% render 'search-input', id: input_id, value: search.terms %}
      </form>
    </div>
  </div>
</div>
