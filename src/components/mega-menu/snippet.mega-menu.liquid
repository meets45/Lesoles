{% liquid
  assign menu_handle = mega_menu.title | handle
  assign menu_type = 'list'
  assign menu_columns = 2
  assign footer_text = ''
  assign footer_url = ''

  for block in section.blocks
    if block.type == 'menu_item'
      assign block_menu_handle = block.settings.menu_id | handle
      if block_menu_handle == menu_handle
        assign menu_type = block.settings.menu_type
        assign menu_columns = block.settings.columns | plus: 0
        assign footer_text = block.settings.link_text
        assign footer_url = block.settings.link_url
        break
      endif
    endif
  endfor
%}

<mega-menu
  data-component="mega-menu"
  id="mega-menu-{{ menu_handle }}-{{ index }}"
  data-mega-menu
  data-active="false"
>
  <div class="mega-menu">
    <div class="mega-menu__topline">
      <div class="mega-menu__topline-heading">
        <button
          type="button"
          class="mega-menu__back"
          data-mega-menu-back
          aria-label="Back to {{ mega_menu.title | escape }}"
          hidden
        >
          {% render 'icon-chevron-left' %}
          <span>Back to {{ mega_menu.title }}</span>
        </button>
        <span class="mega-menu__topline-label" data-mega-menu-current-title tabindex="-1">{{ mega_menu.title }}</span>
      </div>
      <a href="{{ mega_menu.url }}" class="mega-menu__topline-link">Shop all {{ mega_menu.title }} <span aria-hidden="true">↗</span></a>
    </div>

    <div class="mega-menu__layout">
      <div class="mega-menu__rail">
        <p class="mega-menu__eyebrow">Browse by category</p>
        <ul class="mega-menu__categories">
          {% for link in mega_menu.links %}
            {% liquid
              assign link_handle = link.title | handle
              assign has_category_content = false
              for card in section.blocks
                if card.type == 'menu_image' or card.type == 'menu_copy'
                  assign card_menu_handle = card.settings.menu_id | handle
                  assign card_parent_handle = card.settings.parent_menu | handle
                  if card_menu_handle == menu_handle and card_parent_handle == link_handle
                    assign has_category_content = true
                    break
                  endif
                endif
              endfor
            %}
            <li>
              {% if link.links.size > 0 or has_category_content %}
                <button
                  type="button"
                  class="mega-menu__category"
                  data-mega-menu-panel-trigger="{{ forloop.index }}"
                  aria-controls="mega-menu-{{ menu_handle }}-{{ index }}-panel-{{ forloop.index }}"
                  aria-expanded="false"
                >
                  <span>{{ link.title }}</span>
                  {% render 'icon-chevron-right' %}
                </button>
              {% else %}
                <a href="{{ link.url }}" class="mega-menu__category">
                  <span>{{ link.title }}</span>
                  {% render 'icon-arrow-upper-right' %}
                </a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>

      <div class="mega-menu__content">
        <div class="mega-menu__panel" data-mega-menu-panel="overview" data-mega-menu-panel-title="{{ mega_menu.title | escape }}" data-active="true">
          <div class="mega-menu__panel-copy">
            {% render 'menu-panel-copy', section: section, menu_title: mega_menu.title, default_title: mega_menu.title, link_url: mega_menu.url, show_default: true %}
          </div>
          {% render 'menu-content-cards', section: section, menu_title: mega_menu.title %}
        </div>

        {% for link in mega_menu.links %}
          {% liquid
            assign link_handle = link.title | handle
            assign has_category_content = false
            for card in section.blocks
              if card.type == 'menu_image' or card.type == 'menu_copy'
                assign card_menu_handle = card.settings.menu_id | handle
                assign card_parent_handle = card.settings.parent_menu | handle
                if card_menu_handle == menu_handle and card_parent_handle == link_handle
                  assign has_category_content = true
                  break
                endif
              endif
            endfor
          %}
          {% if link.links.size > 0 or has_category_content %}
            <div
              class="mega-menu__panel"
              id="mega-menu-{{ menu_handle }}-{{ index }}-panel-{{ forloop.index }}"
              data-mega-menu-panel="{{ forloop.index }}"
              data-mega-menu-panel-title="{{ link.title | escape }}"
              data-active="false"
            >
              <div class="mega-menu__panel-copy">
                {% render 'menu-panel-copy', section: section, menu_title: mega_menu.title, parent_title: link.title, default_title: link.title, link_url: link.url, show_default: true %}
                {% if link.links.size > 0 %}
                  <div class="mega-menu__sub-list">
                    {% if menu_type == 'enhanced-list' %}
                      {% render 'mega-menu-enhanced-list', list: link, columns: menu_columns %}
                    {% else %}
                      {% render 'mega-menu-list', list: link, columns: menu_columns %}
                    {% endif %}
                  </div>
                {% endif %}
              </div>
              {% render 'menu-content-cards', section: section, menu_title: mega_menu.title, parent_title: link.title %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if footer_text != blank and footer_url != blank %}
      <div class="mega-menu__bottom-link">
        <a href="{{ footer_url }}">{{ footer_text }} <span aria-hidden="true">→</span></a>
      </div>
    {% endif %}
  </div>
</mega-menu>
