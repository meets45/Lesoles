<enhanced-content-collection data-component="enhanced-content-collection">
  <div
    class="enhanced-content-collection"
    role="region"
    aria-label="{{ section.settings.collection.title | escape }}"
    style="{% render 'color-scheme-vars', color_scheme: section.settings.color_scheme %}"
  >
    <div
      class="
        enhanced-content-collection__inner
        {% if section.settings.full-screen %}enhanced-content-collection--full{% endif %}
      "
    >
      {% if section.settings.image %}
        <div class="enhanced-content-collection__image">
          {{ section.settings.image | image_url: width: 800 | image_tag:
            loading: 'lazy',
            alt: section.settings.image.alt | default: section.settings.collection.title,
            sizes: '(min-width: 769px) 45vw, 100vw'
          }}
        </div>
      {% endif %}

      <div class="enhanced-content-collection__content">
        <div class="enhanced-content-collection__header">
          {% render 'content-blocks', section_settings: section.settings, blocks: section.blocks %}
        </div>

        <div class="enhanced-content-collection__slider" data-slider>
          <div
            class="enhanced-content-collection__swiper swiper"
            data-swiper
            role="region"
            aria-roledescription="carousel"
            aria-label="Content cards"
          >
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'card' %}
                    <div
                      class="swiper-slide"
                      role="group"
                      aria-roledescription="slide"
                      aria-label="{{ block.settings.heading | escape }}"
                    >
                      {% render 'content-card',
                        image: block.settings.image,
                        icon: block.settings.icon,
                        heading: block.settings.heading,
                        description: block.settings.description,
                        link_text: block.settings.link_text,
                        link_url: block.settings.link_url,
                        image_ratio: section.settings.image_ratio,
                        style: section.settings.style
                      %}
                    </div>
                {% endcase %}
              {% endfor %}
            </div>
          </div>
          <div class="enhanced-content-collection__nav">
            <button
              class="enhanced-content-collection__prev button-unstyled"
              data-swiper-prev
              aria-label="Previous products"
            >
              {% render 'carousel-arrow', direction: 'left' %}
            </button>
            <button
              class="enhanced-content-collection__next button-unstyled"
              data-swiper-next
              aria-label="Next products"
            >
              {% render 'carousel-arrow', direction: 'right' %}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</enhanced-content-collection>

{% schema %}
{
  "name": "Enhanced Content",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Featured Image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "color_scheme_1"
    },
    {
      "type": "checkbox",
      "id": "full_screen",
      "label": "Full Width",
      "default": false
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "enhanced",
          "label": "Enhanced"
        },
        {
          "value": "overlay",
          "label": "Overlay"
        },
        {
          "value": "enhanced-icon",
          "label": "Enhanced Icon"
        },
      ],
      "default": "enhanced-icon"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        {
          "value": "4:5",
          "label": "4:5"
        },
        {
          "value": "4:3",
          "label": "4:3"
        },
        {
          "value": "1:1",
          "label": "1:1"
        }
      ],
      "default": "4:3"
    },
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "select",
          "id": "heading_level",
          "label": "Heading Level",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            }
          ],
          "default": "h1",
          "info": "This does not affect font size, only SEO and accessibility"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Heading Text"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "variant",
          "label": "Variant",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "tertiary",
              "label": "Tertiary"
            }
          ],
          "default": "primary"
        }
      ]
    },
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Eyebrow Text"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Subheading Text"
        }
      ]
    },
    {
      "type": "card",
      "name": "Content Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Only works when enhanced style is selected."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Content Card Heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Enhanced Content",
      "settings": {
        "style": "enhanced-icon",
      },
      "blocks": [
        { "type": "heading" },
        { "type": "subheading" },
        { "type": "button", "settings": { "variant": "secondary" } },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
