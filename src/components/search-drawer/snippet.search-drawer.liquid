<search-drawer
  data-component="search-drawer"
  data-search-drawer
  data-active="false"
  data-empty-text="{{ 'content.no_results_found' | t | escape }}"
  data-error-text="Search is unavailable. Please try again."
  role="dialog"
  aria-modal="false"
  aria-hidden="true"
  aria-labelledby="search-drawer-heading"
  style="display: none;"
>
  <div class="search-drawer">
    <div class="search-drawer__inner">
      <div class="search-drawer__header">
        <div class="search-drawer__intro">
          <p class="search-drawer__eyebrow">{{ 'content.search' | t }}</p>
          <h2 id="search-drawer-heading">{{ section.settings.search_heading | default: 'Find your next pair.' | escape }}</h2>
          {% if section.settings.search_description != blank %}
            <p class="search-drawer__description">{{ section.settings.search_description | escape }}</p>
          {% endif %}
        </div>
        <button type="button" class="search-drawer__close" data-close aria-label="{{ 'actions.close' | t }}">
          {% render 'icon-close' %}
        </button>
      </div>

      <form class="search-drawer__form{% if section.settings.show_search_cta %} search-drawer__form--with-cta{% endif %}" action="{{ routes.search_url }}" method="get" role="search">
        {% render 'search-input', id: 'search-drawer-input' %}
        {% if section.settings.show_search_cta %}
          <button class="search-drawer__submit" type="submit">
            {{ 'content.search' | t }} <span aria-hidden="true">→</span>
          </button>
        {% endif %}
      </form>

      {% if section.settings.search_links != blank %}
        <nav class="search-drawer__quick-links" data-search-quick-links aria-label="{{ section.settings.search_links_heading | default: 'Popular categories' | escape }}">
          <h3>{{ section.settings.search_links_heading | default: 'Popular categories' | escape }}</h3>
          <ul>
            {% for link in section.settings.search_links.links %}
              <li><a href="{{ link.url }}">{{ link.title | escape }} <span aria-hidden="true">↗</span></a></li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}

      <p class="search-drawer__status" data-search-status role="status" aria-live="polite"></p>

      <div class="search-drawer__results" data-search-results hidden>
        <section class="search-drawer__result-group" data-search-suggestions hidden>
          <h3>{{ 'content.search_results_resource_queries' | t }}</h3>
          <ul class="search-drawer__suggestion-list" data-search-suggestion-list></ul>
        </section>
        <section class="search-drawer__result-group" data-search-products hidden>
          <h3>{{ 'content.search_results_resource_products' | t }}</h3>
          <ul class="search-drawer__product-list" data-search-product-list></ul>
        </section>
        <section class="search-drawer__result-group" data-search-links hidden>
          <h3>{{ 'content.search_results' | t }}</h3>
          <ul class="search-drawer__link-list" data-search-link-list></ul>
        </section>
        <a class="search-drawer__view-all" data-search-view-all href="{{ routes.search_url }}">
          {{ 'content.search_results_view_all' | t }} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</search-drawer>
