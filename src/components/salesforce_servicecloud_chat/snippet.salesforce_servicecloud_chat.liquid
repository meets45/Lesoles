<style>
  .embedded-messaging {
    @media screen and (max-width: 768px) {
      display: none;
    }
  }
</style>
<script type="text/javascript">
  const brand = {{ settings.sfsc_chat_brand | json }}; //parameter to be changed per Brand
  const chatOrigin = {{ settings.sfsc_chat_chat_origin | json }};
  const currentBotLanguage = {{ settings.sfsc_chat_current_bot_language | json }};
  const psmlId =  {{ settings.sfsc_chat_psml_id | json }}
  const miawId = {{ settings.sfsc_chat_miaw_id | json }}
  const chatUrl = '{{ settings.sfsc_chat_url | url_escape }}'
  const scrt2Url = '{{ settings.sfsc_chat_scrt2_url | url_escape }}'

  function initEmbeddedMessaging() {
    try {
      window.addEventListener('onEmbeddedMessagingReady', () => {
        console.log('Received the onEmbeddedMessagingReady event…');
        // Send data to Salesforce
        embeddedservice_bootstrap.prechatAPI.setHiddenPrechatFields({
          Brand: brand,
          ChatOrigin: chatOrigin,
          CurrentBotLanguage: currentBotLanguage,
        });
      });
      embeddedservice_bootstrap.settings.language = chatOrigin; // For example, enter 'en' or 'en-US'
      embeddedservice_bootstrap.init(
        psmlId,
        miawId,
        chatUrl,
        {
          scrt2URL: scrt2Url,
        }
      );
    } catch (err) {
      console.error('Error loading Embedded Messaging: ', err);
    }
  }
</script>
<script
  type="text/javascript"
  defer
  src="{{ settings.sfsc_chat_url | url_escape }}/assets/js/bootstrap.min.js"
  onload="initEmbeddedMessaging()"
></script>
