{% liquid
  assign variant = variant
  assign variant_id = variant.id | default: product.selected_or_first_available_variant.id
  assign quick_add_position = quick_add_position | default: 'image'
  assign quick_add_style = quick_add_style | default: 'icon'

  if quick_add_position != 'details'
    assign quick_add_style = 'icon'
  endif

  assign has_color_options = false
  unless variant
    for product_option in product.options_with_values
      for option_value in product_option.values
        if option_value.swatch != blank
          assign has_color_options = true
          break
        endif
      endfor

      if has_color_options
        break
      endif
    endfor
  endunless

  assign product_href = product.url
  if collection
    assign product_href = product.url | within: collection
  endif
%}

<product-card
  data-component="product-card"
  class="product-card{% if is_variant %} product-card--variant{% endif %}"
  data-product-id="{{ product.id }}"
  data-current-variant-id="{{ display_variant.id }}"
>
  <product-form
    data-product="{{ product | json | escape }}"
    data-variant="{{ variant | default: null | json }}"
  >
    {% form 'product', product %}
      <input type="hidden" name="id" value="{{ variant_id }}">
      {% capture quick_add_button %}
        <button
          class="product-card__add-to-cart{% if quick_add_position == 'details' %} product-card__add-to-cart--details{% endif %}{% if quick_add_style == 'cta' %} product-card__add-to-cart--cta{% endif %}"
          type="submit"
          data-submit
          data-quick-add="true"
        >
          {% if quick_add_style == 'cta' %}
            <span>Quick add</span>
            {% render 'icon-plus' %}
          {% else %}
            {% render 'icon-cart-plus-icon' %}
          {% endif %}
        </button>
      {% endcapture %}
      <div class="product-card__inner">
        {% unless quick_add_position == 'details' %}
          {{ quick_add_button }}
        {% endunless %}
        <div class="product-card__media">
          {% if variant %}
            {% if variant.image %}
              {{
                variant.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 769px) 400px, 200px',
                  class: 'product-card__image'
              }}
            {% else %}
              {{
                product.featured_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 769px) 400px, 200px',
                  class: 'product-card__image'
              }}
            {% endif %}
          {% else %}
            {% render 'product-media-gallery',
              product: product,
              mode: 'compact',
              is_card: true,
              product_href: product_href,
              show_pagination: show_product_slider_indicators
            %}
          {% endif %}
        </div>

        <div class="product-card__content">
          <div class="product-card__content-inner">
            {% unless quick_add_position == 'details' and quick_add_style == 'cta' %}
              <div class="product-card__options">
                {% unless variant %}
                  {% render 'product-form-options',
                    product: product,
                    is_card: true,
                    product_href: product_href
                  %}
                {% endunless %}
              </div>
            {% endunless %}
            <div class="product-card__content-inner-header">
              <div class="product-card__eyebrow">
                <p class="body-medium">Eyebrow</p>
              </div>
              <h2 class="product-card__title">
                <a
                  href="{{ product_href }}{% if variant %}?variant={{ variant.id }}{% endif %}"
                  class="product-card__title-link heading-xsmall"
                >
                  {% if variant %}
                    {{ product.title }} - {{ variant.title }}
                  {% else %}
                    {{ product.title }}
                  {% endif %}
                </a>
              </h2>
              {% if quick_add_position == 'details' and quick_add_style != 'cta' %}
                {{ quick_add_button }}
              {% endif %}
            </div>

            {% render 'product-price', product: product, variant: variant %}
            {% render 'powerreviews-plp-snippet' with product as product %}
            {% if quick_add_position == 'details' and quick_add_style == 'cta' %}
              <div class="product-card__quick-add-row{% unless has_color_options %} product-card__quick-add-row--without-options{% endunless %}">
                {% if has_color_options %}
                  <div class="product-card__options">
                    {% render 'product-form-options',
                      product: product,
                      is_card: true,
                      product_href: product_href,
                      card_swatch_limit: 3
                    %}
                  </div>
                {% endif %}
                {{ quick_add_button }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endform %}
  </product-form>
</product-card>
