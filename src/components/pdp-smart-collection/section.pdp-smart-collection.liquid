<pdp-smart-collection
  data-component="pdp-smart-collection"
  class="pdp-smart-collection">
  <div class="pdp-smart-collection__title-container">
    <div class="pdp-smart-collection__title">
      {% if section.settings.eyebrow != blank %}
        <p class="pdp-smart-collection__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="pdp-smart-collection__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.caption != blank %}
        <p class="pdp-smart-collection__caption">{{ section.settings.caption }}</p>
      {% endif %}
    </div>
    {% if section.settings.cta_text != blank and section.settings.cta_url != blank %}
      <div class="pdp-smart-collection__cta">
        <a href="{{ section.settings.cta_url }}" class="pdp-smart-collection__cta">
          {{ section.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>

  {% if section.settings.fallback_collection != blank %}
    <div class="pdp-smart-collection__collection">
      <div class="pdp-smart-collection__collection-inner">
        {%- assign collection = section.settings.fallback_collection -%}
        <!-- Add your collection display logic here -->
        <div class="pdp-smart-collection__collection-inner">
          {% for product in collection.products %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
</pdp-smart-collection>

{% schema %}
{
  "name": "Smart Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback Collection",
      "info": "This collection will be used if no products are found in the selected collections."
    }
  ],
  "presets": [
    {
      "name": "Smart Collection"
    }
  ]
}
{% endschema %}
