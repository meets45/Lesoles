{% liquid
  assign main_media = section.blocks | where: 'type', 'main_media' | first
  assign secondary_media = section.blocks | where: 'type', 'secondary_media' | first
  assign has_secondary_content = false
  if secondary_media != blank
    if secondary_media.settings.image_desktop != blank or secondary_media.settings.image_tablet != blank or secondary_media.settings.image_mobile != blank or secondary_media.settings.poster_desktop != blank or secondary_media.settings.video_desktop != blank or secondary_media.settings.video_tablet != blank or secondary_media.settings.video_mobile != blank or secondary_media.settings.youtube_desktop != blank or secondary_media.settings.youtube_tablet != blank or secondary_media.settings.youtube_mobile != blank or secondary_media.settings.vimeo_desktop != blank or secondary_media.settings.vimeo_tablet != blank or secondary_media.settings.vimeo_mobile != blank or secondary_media.settings.demo_media
      assign has_secondary_content = true
    endif
    if secondary_media.settings.overlay_enabled
      if secondary_media.settings.overlay_heading != blank or secondary_media.settings.overlay_description != blank or secondary_media.settings.overlay_caption != blank
        assign has_secondary_content = true
      endif
      if secondary_media.settings.overlay_cta_url != blank
        if secondary_media.settings.overlay_cta_label != blank or secondary_media.settings.overlay_cta_arrow
          assign has_secondary_content = true
        endif
      endif
    endif
  endif
  assign show_card = false
  if section.settings.layout_mode == 'split' and has_secondary_content
    assign show_card = true
  endif
  if request.design_mode and section.settings.layout_mode == 'split' and secondary_media != blank
    assign show_card = true
  endif
  assign show_main_media = false
  if main_media != blank and section.settings.layout_mode != 'text_only'
    if main_media.settings.image_desktop != blank or main_media.settings.image_tablet != blank or main_media.settings.image_mobile != blank or main_media.settings.poster_desktop != blank or main_media.settings.video_desktop != blank or main_media.settings.video_tablet != blank or main_media.settings.video_mobile != blank or main_media.settings.youtube_desktop != blank or main_media.settings.youtube_tablet != blank or main_media.settings.youtube_mobile != blank or main_media.settings.vimeo_desktop != blank or main_media.settings.vimeo_tablet != blank or main_media.settings.vimeo_mobile != blank or main_media.settings.demo_media
      assign show_main_media = true
    endif
  endif
  if request.design_mode and main_media != blank and section.settings.layout_mode != 'text_only'
    assign show_main_media = true
  endif
  assign main_arrangement = main_media.settings.foreground_arrangement_desktop | default: 'below'
  assign main_media_first = false
  if show_main_media and main_media.settings.placement != 'background'
    if main_arrangement == 'left' or main_arrangement == 'above'
      assign main_media_first = true
    endif
  endif
  assign homepage_hero = false
  if request.page_type == 'index' and section.index == 1
    assign homepage_hero = true
  endif
%}

<style>
  {{ section.settings.support_font | font_face: font_display: 'swap' }}
  {% assign support_font_semibold = section.settings.support_font | font_modify: 'weight', '600' %}
  {{ support_font_semibold | font_face: font_display: 'swap' }}
  #HeroBanner-{{ section.id }} {
    {% render 'hero-banner-panel-vars', settings: section.settings, device: 'desktop' %}
    {% render 'color-scheme-vars', color_scheme: section.settings.section_color_scheme %}
    --hb-section-bg: {% case section.settings.section_background_mode %}{% when 'solid' %}{{ section.settings.section_color }}{% when 'gradient' %}{{ section.settings.section_gradient | default: section.settings.section_color }}{% else %}var(--surface-primary){% endcase %};
    --hb-main-bg: {% case section.settings.main_background_mode %}{% when 'solid' %}{{ section.settings.main_color }}{% when 'gradient' %}{{ section.settings.main_gradient | default: section.settings.main_color }}{% else %}{{ section.settings.main_color_scheme.settings.surface_primary | default: '#fff3a8' }}{% endcase %};
    --hb-card-bg: {{ section.settings.secondary_background }};
    --hb-main-radius: {{ section.settings.main_radius }}px;
    --hb-card-radius: {{ section.settings.card_radius }}px;
    --hb-border-width: {% if section.settings.border_enable %}{{ section.settings.border_width }}px{% else %}0px{% endif %};
    --hb-border-color: {{ section.settings.border_color }};
    --hb-shadow: {% case section.settings.shadow %}{% when 'soft' %}var(--overlay){% when 'bottom' %}var(--bottom-shadow){% else %}none{% endcase %};
    --hb-max-width: {% if section.settings.max_width_mode == 'custom' %}{{ section.settings.max_width_custom }}px{% else %}1400px{% endif %};
    --hb-progress-active: {{ section.settings.progress_active_color }};
    --hb-progress-inactive: {{ section.settings.progress_inactive_color }};
    --hb-support-font: '{{ section.settings.support_font.family | default: 'Poppins' }}', sans-serif;
  }
  @media (min-width: 750px) and (max-width: 989px) {
    #HeroBanner-{{ section.id }} { {% if section.settings.override_tablet %}{% render 'hero-banner-panel-vars', settings: section.settings, device: 'tablet' %}{% endif %} }
  }
  @media (max-width: 749px) {
    #HeroBanner-{{ section.id }} {
      {% if section.settings.override_tablet %}{% render 'hero-banner-panel-vars', settings: section.settings, device: 'tablet' %}{% endif %}
      {% if section.settings.override_mobile %}{% render 'hero-banner-panel-vars', settings: section.settings, device: 'mobile' %}{% endif %}
    }
  }
  {% for block in section.blocks %}
    {% render 'hero-banner-block-vars', block: block, section_id: section.id %}
  {% endfor %}
</style>

<hero-banner-advanced
  id="HeroBanner-{{ section.id }}"
  data-component="hero-banner-advanced"
  data-section-id="{{ section.id }}"
  data-layout="{{ section.settings.layout_mode }}"
  data-position-desktop="{{ section.settings.position_desktop }}"
  data-position-tablet="{{ section.settings.position_tablet }}"
  data-position-mobile="{{ section.settings.position_mobile }}"
  data-override-tablet="{{ section.settings.override_tablet }}"
  data-override-mobile="{{ section.settings.override_mobile }}"
  data-progress-mode="{{ section.settings.progress_mode }}"
  data-homepage-first="{{ homepage_hero }}"
  class="hb {% unless section.settings.show_desktop %}hb-hide-desktop{% endunless %} {% unless section.settings.show_tablet %}hb-hide-tablet{% endunless %} {% unless section.settings.show_mobile %}hb-hide-mobile{% endunless %} {% if section.settings.width_mode == 'full_bleed' %}hb--full-bleed{% endif %} {% if section.settings.equal_height %}hb--equal-height{% endif %}"
  {% if section.settings.section_anchor != blank %}data-anchor="{{ section.settings.section_anchor | handleize | escape }}"{% endif %}
>
  <div class="hb__container container" {% if section.settings.section_anchor != blank %}id="{{ section.settings.section_anchor | handleize | escape }}"{% endif %}>
    {% capture main_media_panel %}
      {% if show_main_media %}
        {% render 'hero-banner-media', block: main_media, section: section, kind: 'main', priority: homepage_hero %}
      {% endif %}
    {% endcapture %}
    {% capture main_panel %}
      <div class="hb__main" data-main-panel>
        <div class="hb__main-body" data-main-body {% if show_main_media and main_media.settings.placement != 'background' %}data-media-arrangement="{{ main_arrangement }}" data-media-vertical="{{ main_media.settings.media_vertical_desktop }}"{% endif %}>
          {% if main_media_first %}{{ main_media_panel }}{% endif %}
          <div class="hb__content" data-main-content>
            {% render 'hero-banner-content', section: section %}
          </div>
          {% unless main_media_first %}{{ main_media_panel }}{% endunless %}
        </div>
        {% render 'hero-banner-footer', section: section %}
      </div>
    {% endcapture %}
    {% capture card_panel %}
      {% if show_card %}
        {% render 'hero-banner-media', block: secondary_media, section: section, kind: 'secondary', priority: false %}
      {% endif %}
    {% endcapture %}
    <div class="hb__layout" data-layout-container>
      {% if show_card and section.settings.position_desktop == 'left' %}
        {{ card_panel }}{{ main_panel }}
      {% else %}
        {{ main_panel }}{{ card_panel }}
      {% endif %}
    </div>
  </div>
  <dialog class="hb__dialog" data-video-dialog aria-label="Video player">
    <button type="button" class="hb__dialog-close" data-dialog-close aria-label="Close video">&times;</button>
    <div class="hb__dialog-media" data-dialog-media></div>
  </dialog>
</hero-banner-advanced>

