{% liquid
  assign mobile_mega_menu = section.settings.mobile_menu | default: linklists['main-menu']
  assign utility_menu = section.settings.utility_menu
%}

<mobile-mega-menu
  data-component="mobile-mega-menu"
  data-mobile-mega-menu
  data-active="false"
  role="dialog"
  aria-modal="true"
  aria-label="Main menu"
  aria-hidden="true"
  style="display:none;"
>
  <div class="mobile-mega-menu">
    <div class="mobile-mega-menu__topbar">
      {% render 'header-logo', section: section, class: 'mobile-mega-menu__logo' %}
      <button type="button" class="mobile-mega-menu__close" data-close aria-label="{{ 'actions.close' | t }}">
        {% render 'icon-close' %}
      </button>
    </div>

    <nav class="mobile-mega-menu__content" data-mobile-mega-menu-content aria-label="Mobile navigation">
      <p class="mobile-mega-menu__eyebrow">Explore Lésoles</p>
      <h2 class="mobile-mega-menu__heading">Where to today?</h2>
      <ul class="mobile-mega-menu__list">
        {% for link in mobile_mega_menu.links %}
          {% liquid
            assign menu_handle = link.title | handle
            assign has_menu_content = false
            for card in section.blocks
              if card.type == 'menu_image' or card.type == 'menu_copy'
                assign card_menu_handle = card.settings.menu_id | handle
                if card_menu_handle == menu_handle and card.settings.parent_menu == blank
                  assign has_menu_content = true
                  break
                endif
              endif
            endfor
          %}
          <li class="mobile-mega-menu__list-item">
            {% if link.links.size > 0 or has_menu_content %}
              <button
                type="button"
                class="mobile-mega-menu__list-item-button"
                data-mobile-mega-menu-panel-trigger="mobile-{{ forloop.index }}"
                aria-expanded="false"
                aria-label="{{ 'accessibility.show_submenu' | t: title: link.title }}"
              >
                <span>{{ link.title }}</span>
                {% render 'icon-chevron-right' %}
              </button>
            {% else %}
              <a href="{{ link.url }}" class="mobile-mega-menu__list-item-button">
                <span>{{ link.title }}</span>
                {% render 'icon-arrow-upper-right' %}
              </a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>

      {% if utility_menu != blank %}
        <div class="mobile-mega-menu__utility-menu">
          {% render 'mobile-mega-menu-utility-menu', utility_items: utility_menu %}
        </div>
      {% endif %}
    </nav>

    {% for link in mobile_mega_menu.links %}
      {% liquid
        assign menu_handle = link.title | handle
        assign has_menu_content = false
        for card in section.blocks
          if card.type == 'menu_image' or card.type == 'menu_copy'
            assign card_menu_handle = card.settings.menu_id | handle
            if card_menu_handle == menu_handle and card.settings.parent_menu == blank
              assign has_menu_content = true
              break
            endif
          endif
        endfor
      %}
      {% if link.links.size > 0 or has_menu_content %}
        {% assign top_panel_id = 'mobile-' | append: forloop.index %}
        {% render 'mobile-mega-menu-panel', parent: link, panel_id: top_panel_id, level: 1, menu_title: link.title, section: section %}
        {% for child in link.links %}
          {% liquid
            assign menu_handle = link.title | handle
            assign child_handle = child.title | handle
            assign has_category_content = false
            for card in section.blocks
              if card.type == 'menu_image' or card.type == 'menu_copy'
                assign card_menu_handle = card.settings.menu_id | handle
                assign card_parent_handle = card.settings.parent_menu | handle
                if card_menu_handle == menu_handle and card_parent_handle == child_handle
                  assign has_category_content = true
                  break
                endif
              endif
            endfor
          %}
          {% if child.links.size > 0 or has_category_content %}
            {% assign child_panel_id = top_panel_id | append: '-' | append: forloop.index %}
            {% render 'mobile-mega-menu-panel', parent: child, panel_id: child_panel_id, level: 2, menu_title: link.title, section: section %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}
  </div>
</mobile-mega-menu>
