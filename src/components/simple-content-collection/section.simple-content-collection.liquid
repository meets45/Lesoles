<div
  data-component="simple-content-collection"
  class="
    simple-content-collection
    simple-content-collection--{{ section.settings.style }}
  "
  style="{% render 'color-scheme-vars', color_scheme: section.settings.color_scheme %}"
>
  {% render 'section-bg-image', section_settings: section.settings %}

  <div class="simple-content-collection__header">
    {% render 'content-blocks',
      section_settings: section.settings,
      blocks: section.blocks,
      layout: section.settings.heading_layout
    %}
  </div>

  <div class="simple-content-collection__grid">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'card' %}
          <div
            class="simple-content-collection__item" {{ block.shopify_attributes }}
            style="{% render 'color-scheme-vars', color_scheme: section.settings.card_color_scheme %}"
          >
            {% render 'content-card',
              image: block.settings.image,
              heading: block.settings.heading,
              description: block.settings.description,
              link_text: block.settings.link_text,
              link_url: block.settings.link_url,
              image_ratio: section.settings.image_ratio,
              style: section.settings.style
            %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Simple Content Collection",
  "settings": [
    {
      "type": "header",
      "content": "Background Image",
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image - Optional"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image (optional)"
    },
    {
      "type": "range",
      "id": "scrim",
      "min": 0,
      "max": 80,
      "step": 1,
      "label": "Image Overlay",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content Settings",
    },
    {
      "type": "select",
      "id": "heading_layout",
      "label": "Heading Layout",
      "options": [
        {
          "value": "row",
          "label": "row"
        },
        {
          "value": "center",
          "label": "center"
        },
        {
          "value": "default",
          "label": "default"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "enhanced",
          "label": "Enhanced"
        },
        {
          "value": "overlay",
          "label": "Overlay"
        }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        {
          "value": "4:5",
          "label": "4:5"
        },
        {
          "value": "4:3",
          "label": "4:3"
        },
        {
          "value": "1:1",
          "label": "1:1"
        }
      ],
      "default": "4:5"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "color_scheme_1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "color_scheme_1"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "select",
          "id": "heading_level",
          "label": "Heading Level",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            }
          ],
          "default": "h1",
          "info": "This does not affect font size, only SEO and accessibility"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Heading Text"
        }
      ]
    },
    {
      "type": "body",
      "name": "Body",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Body text is optional. Velit adipiscing viverra tempus feugiat.  Nisl dui libero turpis dolor egestas ipsum nam.  Duis aute irure dolor in reprehenderit.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "variant",
          "label": "Variant",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "tertiary",
              "label": "Tertiary"
            }
          ],
          "default": "primary"
        }
      ]
    },
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Eyebrow Text"
        }
      ]
    },
    {
      "type": "card",
      "name": "Content Card",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Content Card Heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Simple Content Collection",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
