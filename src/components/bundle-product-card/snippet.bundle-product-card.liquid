{% assign variant = variant %}
{% assign variant_id = variant.id | default: product.selected_or_first_available_variant.id %}

<bundle-product-card
  data-component="bundle-product-card"
  class="product-card{% if is_variant %} product-card--variant{% endif %}"
  data-product-id="{{ product.id }}"
  data-current-variant-id="{{ variant_id }}"
  data-category="{{ category_id }}"
  data-product="{{ product | json | escape }}"
>
  <div class="product-card__inner">
    <div class="product-card__media">
      <button
        class="product-card__add-to-cart"
        type="button"
        data-bundle-add-to-cart
      >
        {% render 'icon-cart-plus-icon' %}
      </button>
      {% render 'product-media-gallery', product: product, mode: 'compact' %}
    </div>

    <div class="product-card__content">
      <div class="product-card__content-inner">
        <div class="product-card__options">
          {% render 'product-form-options', product: product, is_card: true %}
        </div>

        <div class="product-card__content-inner-header">
          <h2 class="product-card__title">
            <a href="{{ product.url }}" class="product-card__title-link heading-xsmall">
              {{ product.title }}
            </a>
          </h2>
        </div>

        {% render 'product-price',
          product: product,
          variant: product.selected_or_first_available_variant
        %}
      </div>
    </div>
  </div>
</bundle-product-card>
