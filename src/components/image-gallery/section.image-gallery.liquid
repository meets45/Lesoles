{% comment %}
------------------------------------------------------------------------------
  Section: Image Gallery
  - Displays content blocks alongside image gallery
  - Responsive layout with stacked mobile view
------------------------------------------------------------------------------
{% endcomment %}

<div
  data-component="image-gallery"
  class="
    image-gallery
    image-gallery__content
    {% if section.settings.full_screen %}
      image-gallery--full-screen
    {% endif %}
  "
  style="{% render 'color-scheme-vars', color_scheme: section.settings.color_scheme %}"
>
  <div class="image-gallery__content-wrapper">
    {% render 'content-blocks',
      blocks: section.blocks,
      section_settings: section.settings,
      layout: 'row'
    %}
  </div>

  <div class="image-gallery__images">
    {% for block in section.blocks %}
      {% if block.type == 'image' %}
        <div class="image-gallery__image-wrapper">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 1024px) 50vw, 100vw',
              widths: '550, 720, 990, 1100, 1500, 2200',
              class: 'image-gallery__image'
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'image-gallery__image placeholder' }}
          {%- endif -%}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Image Gallery",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_screen",
      "label": "Full Screen",
      "default": false
    },
    {
      "type": "select",
      "id": "text_alignment_desktop",
      "label": "Text Alignment - Desktop",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Text Alignment - Mobile",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "color_scheme_1",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "select",
          "id": "heading_level",
          "label": "Heading Level",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            }
          ],
          "default": "h1",
          "info": "This does not affect font size, only SEO and accessibility"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Heading Text"
        }
      ]
    },
    {
      "type": "body",
      "name": "Body",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Body text is optional. Velit adipiscing viverra tempus feugiat. Nisl dui libero turpis dolor egestas ipsum nam. Duis aute irure dolor in reprehenderit.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "variant",
          "label": "Variant",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "tertiary",
              "label": "Tertiary"
            }
          ],
          "default": "primary"
        }
      ]
    },
    {
      "type": "text_link",
      "name": "Text Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Text Link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    },
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Eyebrow Text"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Subheading Text"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Gallery",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "subheading" },
        { "type": "button", "settings": { "variant": "secondary" } },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
