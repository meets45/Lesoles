  {
    "name": "Lesoles Team Discount",
    "settings": [
      {
        "type": "header",
        "content": "Modal",
      },
      {
        "type": "text",
        "id": "employee_modal_title",
        "label": "Modal Title",
        "default": "Lesoles Team Discount Policy"
      },
      {
        "type": "richtext",
        "id": "employee_modal_content",
        "label": "Modal Content",
        "default": "<p>By continuing, I acknowledge the <a href=\"\/pages\/employee-discount\">Lesoles Team Discount Policy</a>.</p>"
      },
      {
        "type": "header",
        "content": "Banner",
      },
      {
        "type": "text",
        "id": "discount_threshold",
        "label": "Employee discount threshold",
        "default": "10000.00",
        "info": "This should match the amount assigned in the customer metafield `custom.employee_spend`"
      }
    ]
  },
