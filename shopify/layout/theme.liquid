<!doctype html>
  <html
    class="js"
    lang="{{ request.locale.iso_code }}"
    {% if customer.tags contains 'customer-employee' %}
      data-employee
    {% endif %}
  >
    <head>
      <meta charset="utf-8">
      <meta http-equiv="X-UA-Compatible" content="IE=edge">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <meta name="theme-color" content="">
      <link rel="canonical" href="{{ canonical_url }}">

      {%- if settings.favicon != blank -%}
        <link
          rel="icon"
          type="image/png"
          href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
        >
      {%- endif -%}

      <title>
        {{ page_title }}
        {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
        {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
      </title>

      {% if page_description %}
        <meta name="description" content="{{ page_description | escape }}">
      {% endif %}

      {{ content_for_header }}

      <script>
        if (Shopify.designMode) {
          document.documentElement.classList.add('shopify-design-mode');
        }
      </script>

      {% render 'fonts' %}
      {% render 'variables' %}

      {% liquid
        render 'vite-tag' with 'style.scss'
        render 'vite-tag' with 'main.js'
      %}

      {% render 'vendor-onetrust' %}
      {% render 'vendor-quantum-metric' %}
      {% render 'vendor-curalate' %}
      {% render 'gtm-storefront-snippet' %}

      {% if page.template_suffix contains 'sheer-id' %}
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@sheerid/jslib@2/sheerid-install.css"
          type="text/css"
          crossorigin="anonymous"
        >
      {% endif %}
      {% render 'onetrust_datalayer_tracking' %}
      {% render 'styleguide' %}
    </head>

    <body style="visibility: hidden;">
      <a class="skip-to-content-link" href="#MainContent">
        {{ 'accessibility.skip_to_text' | t }}
      </a>

      {% sections 'header-group' %}

      <main id="MainContent" role="main">
        {{ content_for_layout }}
      </main>

      <ul hidden>
        <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
        <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
      </ul>

      {% section 'minicart' %}

      {% if customer.tags contains 'customer-employee' %}
        {% section 'employee-discount-modal' %}
      {% endif %}

      {% section 'signup-modal' %}
      {% sections 'footer-group' %}

      <script>
        window.shopUrl = '{{ request.origin }}';
        window.routes = {
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          cart_update_url: '{{ routes.cart_update_url }}',
          cart_url: '{{ routes.cart_url }}',
          search: '{{ routes.search_url }}',
          predictive_search_url: '{{ routes.predictive_search_url }}',
        };


        window.strings = {
          products: {
            facets: {
              open_filter: {{ 'products.facets.open_filter' | t | json }},
              close_filter: {{ 'products.facets.close_filter' | t | json }},
              apply: {{ 'products.facets.apply' | t | json }},
              apply_with_count: {{ 'products.facets.apply_with_count' | t | json }},
              product_count: {{ 'products.facets.product_count' | t | json }},
              remove_filter: {{ 'products.facets.remove_filter' | t | json }},
              clear_all: {{ 'products.facets.clear_all' | t | json }}
            }
          }
        };

        window.customer = {
          loggedIn: {% if customer %}true{% else %}false{% endif %},
          isEmployee: {% if customer.tags contains 'customer-employee' %}true{% else %}false{% endif %},
          employeeSpend: {% if customer and customer.tags contains 'customer-employee' %}{{ customer.metafields.custom.employee_spend | json }}{% else %} false {% endif %},
          newsletter: {% if customer and customer.tags contains 'newsletter' %}true{% else %}false{% endif %}
        }
      </script>
      {% render 'salesforce_servicecloud_chat' %}
      {% if template == 'index' or template == 'product' or template == 'collection' %}
        {% render 'swatch-clicked-event' %}
      {% endif %}
      {%- render 'powerreviews' -%}
    </body>
  </html>
