    "section_accordions_WCM7JQ": {
      "type": "section-accordions",
      "blocks": {
        "accordion_wEGRAq": {
          "type": "accordion",
          "settings": {
            "title": "What are JanSport's shipping terms?",
            "content": "<p>The legal title to purchase product transfers to the buyer at point of shipment.</p>"
          }
        },
        "accordion_UXzaLy": {
          "type": "accordion",
          "settings": {
            "title": "Can I ship to international addresses?",
            "content": "<p>No. JanSport.com currently does not ship orders to international countries.</p><p>To find your local warranty policy including where to submit, please change your country selection on the bottom right corner of this website page.</p>"
          }
        },
        "accordion_bKBeeR": {
          "type": "accordion",
          "settings": {
            "title": "Can I ship my JanSport order to APO/FPO addresses?",
            "content": "<p>No. JanSport.com currently does not ship orders to APO/FPO addresses.</p>"
          }
        },
        "accordion_Xmy3ny": {
          "type": "accordion",
          "settings": {
            "title": "Can I ship my order to someone else or a different address?",
            "content": "<p>Yes, orders can be shipped to a different address than the billing address. After you enter your billing address during checkout, you’ll have the option to enter a new shipping address (different from billing address). We also offer gifting options, which allow you to select a gift for a recipient or send a gift card. Learn more <a href=\"https://www.jansport.com/en_us/egifting-a-backpack.html\">here.</a></p>"
          }
        },
        "accordion_HyJHwe": {
          "type": "accordion",
          "settings": {
            "title": "How is the shipping cost determined?",
            "content": "<p>For orders $50.00+ the shipping cost is based on an item’s size, weight, shipping method and delivery address. </p><p>For orders $49.99 and under, shipping is a flat $5.00 charge for standard shipping.</p>"
          }
        }
      },
